<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- Scanning for the trainer/HRM does not derive physical location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Only required pre-Android 12, where BLE scanning itself needs location access. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".OsmRideApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OsmRide">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.OsmRide">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Lets fosslift (a companion app on the same device) share a completed strength
              workout in via osmride://import-workout?data=<url-encoded liftohistory text> - the
              payload is fosslift's own "Copy as Text" export format, not something invented for
              this integration. See StrengthWorkoutImport.kt/LiftohistoryImport.kt. android:host
              is intentionally not also wildcarded/omitted - only this exact host is a workout
              import; any other osmride:// deep link added later gets its own host, not folded
              into this filter.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="osmride"
                    android:host="import-workout" />
            </intent-filter>

            <!--
              Lets OSM Ride show up in the OS Sharesheet when another app (a bike computer's
              companion app - e.g. Wahoo ELEMNT, Garmin Connect - or a file manager) shares a .fit
              file - see MainActivity's ACTION_SEND/ACTION_SEND_MULTIPLE handling/
              FitFileImporter.kt. There's no IANA-registered MIME type for .fit, and guessing
              specific candidates (application/octet-stream, application/vnd.ant.fit) didn't match
              what Wahoo's ELEMNT app actually declares - confirmed missing from its Sharesheet
              on-device, not just theorized. android:mimeType="*/*" matches any declared type
              instead of guessing again; this is safe to be broad because FitFileImporter already
              rejects (with a clear Toast, not a crash) anything that doesn't actually parse as a
              FIT file, so the only real cost is OSM Ride occasionally appearing as a share target
              for unrelated files too (confirmed on-device: it now does, and correctly rejects
              them). SEND_MULTIPLE is included alongside plain SEND because some apps always use
              the multi-file share path even for a single file - ELEMNT was still missing from the
              Sharesheet with only SEND declared, despite */* now matching every other app's
              single-file shares, which points at exactly this.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
          specialUse rather than connectedDevice: on Android 14+, connectedDevice-type foreground
          services require BLUETOOTH_CONNECT (or similar) to be actually granted at
          startForeground() time, not just declared — which crashed ride start when using the
          simulated trainer (no real BLE, so that permission is never requested/granted).
          specialUse has no such runtime-grant requirement.
        -->
        <service
            android:name=".ride.RideForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="indoor-trainer-ride-tracking" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
